{
  "name": "figure-chess",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "vitest run tests/rules.test.ts tests/differential.test.ts",
    "test:services": "vitest run tests/services.test.ts",
    "test:browser": "playwright test",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "postgres": "3.4.7",
    "zod": "4.3.6",
    "lucide-react": "0.577.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "tsx": "4.21.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "ffish": "0.7.10"
  },
  "type": "module"
}
